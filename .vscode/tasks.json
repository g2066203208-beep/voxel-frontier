{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VF: Build Debug",
      "type": "process",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\scripts\\build-game.ps1",
        "-Configuration", "Debug"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "VF: Run Debug",
      "type": "process",
      "command": "${workspaceFolder}\\build\\vscode-windows\\Debug\\voxel_frontier.exe",
      "dependsOn": ["VF: Build Debug"],
      "dependsOrder": "sequence",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "VF: Build Release",
      "type": "process",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\scripts\\build-game.ps1",
        "-Configuration", "Release"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "VF: Run Release",
      "type": "process",
      "command": "${workspaceFolder}\\build\\vscode-windows\\Release\\voxel_frontier.exe",
      "dependsOn": ["VF: Build Release"],
      "dependsOrder": "sequence",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
