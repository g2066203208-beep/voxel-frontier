{
  "manifest_version": 3,
  "name": "Paper Studio 文献下载助手",
  "version": "0.1.0",
  "description": "在已登录 CARSI/出版社的浏览器中，按 Paper Studio 队列逐篇打开并下载论文 PDF。不会读取或上传账号、密码和 Cookie。",
  "permissions": ["tabs", "storage", "downloads", "scripting"],
  "host_permissions": [
    "https://doi.org/*",
    "https://www.sciencedirect.com/*",
    "https://sciencedirect.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "Paper Studio 文献下载助手",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.sciencedirect.com/*", "https://sciencedirect.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
