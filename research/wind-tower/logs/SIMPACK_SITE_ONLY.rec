    'RNA_ROTATION_EXPLICIT', distributionType=UNIFORM, field='', magnitude=
    1500.0, name='WIND_PRESSURE_DTU_BLADE_SMOOTH_2_1', region=
    mdb.models['RNA_REAL_EXPLICIT'].rootAssembly.surfaces['SURF_RNA_DTU_BLADE_SMOOTH_2_1'])
mdb.models['RNA_REAL_EXPLICIT'].Pressure(amplitude='WIND_RAMP', createStepName=
    'RNA_ROTATION_EXPLICIT', distributionType=UNIFORM, field='', magnitude=
    1500.0, name='WIND_PRESSURE_DTU_BLADE_SMOOTH_3_1', region=
